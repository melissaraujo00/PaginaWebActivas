@model IEnumerable<AppWeb2.Models.VideoJuego>
@{
    ViewData["Title"] = "Videojuegos";
}

<div class="container">
    @await Html.PartialAsync("_FeatureCards")
</div>

<div class="container mt-5">
    <h2 class="text-center fw-bold mb-4" style="color: #FFD700;">Videojuegos Disponibles</h2>
    <div class="row g-4">
        @foreach (var juego in Model)
        {
            @await Html.PartialAsync("_GameCard", juego)
        }
    </div>
</div>