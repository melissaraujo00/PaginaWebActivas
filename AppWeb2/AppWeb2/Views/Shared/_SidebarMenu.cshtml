@{
    var esAdmin = Context.Session.GetInt32("idRol") == 1;
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
}

<nav class="col-md-3 col-lg-2 d-md-block sidebar p-0" style="background-color: #2c3e50; color: #ecf0f1;">
    <div class="position-sticky pt-3">
        <ul class="nav flex-column">
            @if (esAdmin)
            {

                <li class="nav-item">
                    <a class="nav-link text-white @(currentController == "Account" && currentAction == "Dashboard" ? "active bg-primary" : "")"
                           asp-controller="Account" asp-action="Dashboard">
                        <i class="fas fa-tachometer-alt me-2"></i> Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white @(currentController == "Account" && currentAction == "DetalleVentas" ? "active bg-primary" : "")"
                           asp-controller="Account" asp-action="DetalleVentas">
                        <i class="fas fa-chart-line me-2"></i> Ventas
                    </a>
                </li>


                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle text-white" href="#" id="gestionJuegosDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fas fa-gamepad me-2"></i> VideoJuegos
                    </a>
                    <ul class="dropdown-menu" aria-labelledby="gestionJuegosDropdown" style="background-color: #34495e;">
                        <li><a class="dropdown-item text-white" asp-controller="VideoJuegos" asp-action="Index">Listado de Juegos</a></li>
                        <li><a class="dropdown-item text-white" asp-controller="VideoJuegos" asp-action="Create">Crear Juego</a></li>
                        <li><a class="dropdown-item text-white" asp-controller="VideoJuegos" asp-action="Promocion">Promociones</a></li>
                        <li><a class="dropdown-item text-white" asp-controller="VideoJuegos" asp-action="Nuevo">Nuevos Lanzamientos</a></li>
                    </ul>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white @(currentController == "Categoria" ? "active bg-primary" : "")"
                           asp-controller="Categoria" asp-action="Index">
                        <i class="fas fa-tags me-2"></i> Categorías
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white @(currentController == "Clientes" ? "active bg-primary" : "")"
                           asp-controller="Account" asp-action="Clientes">
                        <i class="fas fa-tags me-2"></i> Clientes
                    </a>
                </li>
            }
            else
            {

                <li class="nav-item">
                    <a class="nav-link text-white @(currentController == "Account" && currentAction == "JuegosVenta" ? "active bg-primary" : "")"
                           asp-controller="Account" asp-action="JuegosVenta">
                        <i class="fas fa-store me-2"></i> Tienda
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white @(currentController == "Account" && currentAction == "MisCompras" ? "active bg-primary" : "")"
                           asp-controller="Account" asp-action="MisCompras">
                        <i class="fas fa-shopping-bag me-2"></i> Mis Compras
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="VideoJuegos" asp-action="Promocion">
                        <i class="fas fa-tags me-2"></i> Promociones
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="VideoJuegos" asp-action="Nuevo">
                        <i class="fas fa-star me-2"></i> Nuevos Lanzamientos
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="Categoria" asp-action="Index" >
                        <i class="fas fa-tags me-2"></i> Categorías
                    </a>
                </li>
            }
        </ul>
    </div>
</nav>

<style>

    .sidebar {
        box-shadow: 2px 0 5px rgba(0,0,0,0.1);
        overflow-y: auto;
        position: sticky;
        top: 0; 
        height: 100vh; 
    }

        .sidebar .nav-link {
            border-radius: 0;
            transition: all 0.2s;
            padding: 12px 20px;
        }

            .sidebar .nav-link:hover {
                background-color: #1abc9c;
                color: white !important;
            }

            .sidebar .nav-link.active {
                background-color: #0d6efd !important;
            }

   .sidebar .dropdown-menu {
        position: sticky;
        top: 0; 
        height: 100vh; 
        overflow-y: auto; 
    }


        .sidebar .dropdown-item {
            color: #ecf0f1;
            padding: 10px 20px;
            transition: 0.2s;
        }

.sidebar .dropdown-item:hover {
    background-color: #1abc9c;
    color: white;
}

        .sidebar .dropdown-toggle::after {
            float: right;
            margin-top: 8px;
        }
</style>