@model List<VentaViewModel>
@{ ViewData["Title"] = "Mis Compras";
    ViewBag.HideBanner = true;

    var filtrosModel = new AppWeb2.Models.FiltrosPaginacionViewModel
    {
        Desde = ViewBag.Desde,
        Hasta = ViewBag.Hasta,
        SearchString = ViewBag.SearchString,
        LabelSearch = "NOMBRE DEL JUEGO", 
        MostrarEstado = false,            
        PaginaActual = ViewBag.PaginaActual,
        TotalPaginas = ViewBag.TotalPaginas,
        Controller = "Account",
        Action = "MisCompras"
    };

}

<div class="container mt-4">
    <h2 class="mb-4" style="color: var(--primary);">Mis Compras</h2>

    @await Component.InvokeAsync("FiltrosPaginacion", new { model = filtrosModel })

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead style="background-color: var(--primary); color: white;">
                <tr>
                    <th>Juego</th>
                    <th>Cantidad</th>
                    <th>Total</th>
                    <th>Estado</th>
                    <th>Fecha</th>
                    <th>Código</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.TituloJuego</td>
                        <td>@item.cantidad</td>
                        <td class="fw-bold" style="color: var(--primary);">$@item.total.ToString("F2")</td>
                        <td><span class="badge bg-success">@item.estadoCompra</span></td>
                        <td>@item.fechaHoraTransaccion.ToString("dd/MM/yyyy")</td>
                        <td><code>@item.codigoTransaccion</code></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">No se encontraron compras.</div>
    }
</div>