@model AppWeb2.Models.MiPerfilViewModel
@{
    ViewData["Title"] = "Mi Perfil";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header text-white" style="background-color: #1E88E5;">
                    <h4 class="mb-0"><i class="fas fa-user-edit me-2"></i>Editar Mi Perfil</h4>
                </div>
                <div class="card-body p-4">
                    
                    @if (ViewBag.Exito != null)
                    {
                        <div class="alert alert-success"><i class="fas fa-check-circle me-2"></i>@ViewBag.Exito</div>
                    }

                    <form asp-action="MiPerfil" method="post">
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Nombre Completo</label>
                                <input asp-for="Nombre" class="form-control" />
                                <span asp-validation-for="Nombre" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Correo Electrónico</label>
                                <input asp-for="Email" class="form-control" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                            <!-- Enlace directo a la vista de seguridad -->
                            <a asp-action="CambiarPassword" class="btn btn-outline-secondary">
                                <i class="fas fa-lock me-2"></i>Ir a Cambiar Contraseña
                            </a>
                            
                            <button type="submit" class="btn btn-primary px-4" style="background-color: #1E88E5; border: none;">
                                <i class="fas fa-save me-2"></i> Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}