@model AppWeb2.Models.CambiarPasswordViewModel
@{
    ViewData["Title"] = "Cambiar Contraseña";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header text-white text-center py-3" style="background-color: #1E88E5;">
                    <h4 class="mb-0"><i class="fas fa-lock me-2"></i>Seguridad de la Cuenta</h4>
                </div>
                <div class="card-body p-4">
                    
                    @if (ViewBag.Exito != null)
                    {
                        <div class="alert alert-success text-center">
                            <i class="fas fa-check-circle me-2"></i> @ViewBag.Exito
                        </div>
                    }

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger text-center">
                            <i class="fas fa-exclamation-triangle me-2"></i> @ViewBag.Error
                        </div>
                    }

                    <form asp-action="CambiarPassword" method="post">
                        <div class="mb-3">
                            <label class="form-label text-muted fw-bold">Contraseña Actual</label>
                            <input asp-for="PasswordActual" type="password" class="form-control bg-light" />
                            <span asp-validation-for="PasswordActual" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-muted fw-bold">Nueva Contraseña</label>
                            <input asp-for="NuevaPassword" type="password" class="form-control" />
                            <span asp-validation-for="NuevaPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label text-muted fw-bold">Confirmar Nueva Contraseña</label>
                            <input asp-for="ConfirmarPassword" type="password" class="form-control" />
                            <span asp-validation-for="ConfirmarPassword" class="text-danger small"></span>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary py-2" style="background-color: #1E88E5; border: none; font-weight: bold;">
                                Actualizar Contraseña
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}