@{
    ViewBag.HideBanner = true;
    ViewData["Title"] = "Compra Exitosa";
}

<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="col-md-6 col-lg-5 text-center">
        <div class="card checkout-card shadow-lg border-0" style="background-color: var(--card-bg); border-radius: 1.5rem;">
            <div class="card-body p-5">
                <i class="fas fa-check-circle fa-5x mb-4" style="color: #10b981;"></i>
                <h2 class="fw-bold mb-3" style="color: var(--primary);">¡Gracias por tu compra!</h2>
                <p class="text-muted mb-4">Tu pedido ha sido procesado exitosamente. Recibirás un correo con los detalles.</p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-accent px-4 py-2">Volver al inicio</a>
            </div>
        </div>
    </div>
</div>