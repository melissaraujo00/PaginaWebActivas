@model AgenciaEnvio.Models.Sucursal

@{
    ViewData["Title"] = "Eliminar Sucursal";
}

<div class="crud-container">
    <div class="crud-header">
        <h2>@ViewData["Title"]</h2>
    </div>

    <div class="form-card">
        <div class="delete-alert">
            ⚠️ ¿Estás seguro que deseas eliminar esta sucursal? Esta acción es permanente y no se puede deshacer.
        </div>

        <dl class="dl-horizontal">
            <dt>
                @Html.DisplayNameFor(model => model.Nombre)
            </dt>
            <dd>
                @Html.DisplayFor(model => model.Nombre)
            </dd>

            <dt>
                @Html.DisplayNameFor(model => model.Direccion)
            </dt>
            <dd>
                @Html.DisplayFor(model => model.Direccion)
            </dd>

            <dt>
                @Html.DisplayNameFor(model => model.Telefono)
            </dt>
            <dd>
                @Html.DisplayFor(model => model.Telefono)
            </dd>
        </dl>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />

            <div class="form-actions">
                <button type="submit" class="btn btn-danger">Sí, Eliminar Definitivamente</button>
                <a asp-action="Index" class="btn btn-secondary">Regresar a la lista</a>
            </div>
        </form>
    </div>
</div>